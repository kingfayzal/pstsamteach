# Local development uses a SQLite file. In production point this at Turso:
#   DATABASE_URL="libsql://<db-name>-<org>.turso.io"
DATABASE_URL="file:./dev.db"

# Only needed for a remote libSQL/Turso database. Leave empty locally.
DATABASE_AUTH_TOKEN=""

# Used by `npm run db:seed` for every demo account. If unset, the seed
# generates a random password and prints it once to the terminal.
SEED_DEMO_PASSWORD=""
