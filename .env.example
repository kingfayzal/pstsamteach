# ---------------------------------------------------------------------------
# Local development: `npm run db:up` starts Postgres in Docker (docker-compose.yml).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres@localhost:5432/pstsamteach"
DIRECT_URL="postgresql://postgres@localhost:5432/pstsamteach"

# ---------------------------------------------------------------------------
# Production (Supabase): set these in Vercel -> Project -> Settings -> Environment Variables.
# Supabase dashboard -> Connect:
#   DATABASE_URL = "Transaction pooler" connection string (port 6543), used by the app
#   DIRECT_URL   = "Session pooler" connection string (port 5432), used for migrations
# Optional: DATABASE_CA_CERT = Supabase's root certificate (PEM, from
# Database Settings -> SSL), so the server certificate is verified.
# ---------------------------------------------------------------------------

# Optional: connections per server instance (default 10 locally, 3 on Vercel).
# DATABASE_POOL_MAX="3"

# Optional: override the contact details shown in the app. The defaults in
# src/lib/site.ts are Xcel Study's public ones. The name is set there too.
# SUPPORT_EMAIL="xcelstudy5@gmail.com"
# SUPPORT_PHONE="+1 (240) 302-9182"

# Used by `npm run db:seed` for every demo account. If unset, the seed
# generates a random password and prints it once to the terminal.
SEED_DEMO_PASSWORD=""

# ---------------------------------------------------------------------------
# Optional: live video sessions (LiveKit, see docs/adr/0001). Leave all three
# unset and sessions keep using the teacher's own meeting link. Setting only
# some of them fails the build on purpose.
#
# Locally: choose any key name and a long random secret (for example
# `openssl rand -hex 32`), then `npm run livekit:up` starts LiveKit in Docker
# with the same pair.
#   LIVEKIT_URL="ws://localhost:7880"
#
# Production: create a LiveKit Cloud project, set its wss:// URL, API key and
# secret in Vercel, and point the project's webhook at
# https://<your-domain>/api/livekit/webhook so attendance is recorded.
# ---------------------------------------------------------------------------
# LIVEKIT_URL=""
# LIVEKIT_API_KEY=""
# LIVEKIT_API_SECRET=""

# ---------------------------------------------------------------------------
# Email (Resend, see docs/adr/0002). Leave RESEND_API_KEY and EMAIL_FROM unset
# locally: emails are printed to the terminal instead, links included. Setting
# only one of them fails the build, and production builds fail without both.
#
# Production: a Resend API key with sending access, and a sender on a domain
# verified in Resend (not a Gmail address). CRON_SECRET signs the daily email
# job (vercel.json). APP_URL is where links in emails point; it defaults to
# Vercel's own address for the deployment, or http://localhost:3000 locally.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM="Xcel Study <hello@mail.xcelstudy.com>"
# EMAIL_REPLY_TO=
# CRON_SECRET=
# APP_URL=
