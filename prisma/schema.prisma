generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
}

enum AssessmentKind {
  QUIZ
  ASSIGNMENT
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
}

enum Audience {
  EVERYONE
  STUDENTS
  TEACHERS
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  DECLINED
  ENDED
}

enum TutoringStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  name                 String
  passwordHash         String
  role                 Role       @default(STUDENT)
  status               UserStatus @default(ACTIVE)
  bio                  String?
  /// Teacher applications: what they want to teach and why.
  applicationNote      String?
  applicationSubjectId String?
  lastLoginAt          DateTime?
  /// IANA time zone, e.g. Africa/Lagos. Null until captured from the browser or set in Account.
  timeZone             String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  sessions           Session[]
  courses            Course[]         @relation("CourseTeacher")
  enrollments        Enrollment[]
  lessonProgress     LessonProgress[]
  submissions        Submission[]     @relation("SubmissionStudent")
  gradedSubmissions  Submission[]     @relation("SubmissionGrader")
  announcements      Announcement[]
  auditLogs          AuditLog[]
  applicationSubject Subject?         @relation("ApplicationSubject", fields: [applicationSubjectId], references: [id], onDelete: SetNull)

  teacherProfile     TeacherProfile?
  studentConnections TeacherConnection[] @relation("ConnectionStudent")
  teacherConnections TeacherConnection[] @relation("ConnectionTeacher")
  tutoringSessions   TutoringSession[]   @relation("SessionTeacher")
  messages           Message[]
  reviewsWritten     TeacherReview[]     @relation("ReviewStudent")
  reviewsReceived    TeacherReview[]     @relation("ReviewTeacher")
  savedTeachers      SavedTeacher[]      @relation("SavedBy")
  savedBy            SavedTeacher[]      @relation("SavedTeacher")
  sessionAttendance  SessionAttendance[]

  @@index([role, status])
}

model Session {
  /// SHA-256 of the session token. The raw token only ever lives in the cookie.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subject {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String   @unique
  tagline     String
  description String
  /// Hex colour, e.g. #2356C2. Used for covers and tags.
  color       String
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses    Course[]
  applicants User[]   @relation("ApplicationSubject")
  topics     Topic[]
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  summary     String
  description String
  level       CourseLevel  @default(FOUNDATION)
  status      CourseStatus @default(DRAFT)
  isFeatured  Boolean      @default(false)
  /// Admin note when a course is sent back to draft.
  reviewNote  String?
  submittedAt DateTime?
  publishedAt DateTime?
  subjectId   String
  teacherId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subject       Subject        @relation(fields: [subjectId], references: [id])
  teacher       User           @relation("CourseTeacher", fields: [teacherId], references: [id])
  lessons       Lesson[]
  assessments   Assessment[]
  enrollments   Enrollment[]
  announcements Announcement[]

  @@index([subjectId, status])
  @@index([teacherId])
  @@index([status])
}

model Lesson {
  id              String   @id @default(cuid())
  courseId        String
  title           String
  /// Markdown. Rendered without raw HTML.
  body            String
  videoUrl        String?
  durationMinutes Int      @default(10)
  position        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([courseId, position])
}

model Assessment {
  id           String         @id @default(cuid())
  courseId     String
  title        String
  instructions String
  kind         AssessmentKind
  position     Int
  /// Points available for assignments. Quizzes score one point per question.
  maxPoints    Int            @default(100)
  passPercent  Int            @default(60)
  dueAt        DateTime?
  isPublished  Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   Question[]
  submissions Submission[]

  @@index([courseId, position])
}

model Question {
  id           String   @id @default(cuid())
  assessmentId String
  prompt       String
  explanation  String?
  position     Int
  createdAt    DateTime @default(now())

  assessment Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options    QuestionOption[]

  @@index([assessmentId, position])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  label      String
  isCorrect  Boolean @default(false)
  position   Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Submission {
  id           String           @id @default(cuid())
  assessmentId String
  studentId    String
  /// Quiz answers as JSON: { [questionId]: optionId }.
  answers      String?
  /// Assignment written response.
  response     String?
  score        Int?
  maxScore     Int
  status       SubmissionStatus @default(SUBMITTED)
  feedback     String?
  gradedById   String?
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    User       @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@index([assessmentId, studentId])
  @@index([studentId])
  @@index([status])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  /// Null = platform-wide announcement from an admin.
  courseId  String?
  audience  Audience @default(EVERYONE)
  authorId  String
  createdAt DateTime @default(now())

  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Choose your teacher: profiles, topics, availability, connections, sessions.
// ---------------------------------------------------------------------------

model TeacherProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  slug              String   @unique
  headline          String   @default("")
  about             String   @default("")
  teachingStyle     String?
  experienceYears   Int?
  qualifications    String?
  /// YouTube or Vimeo introduction video.
  videoUrl          String?
  /// The teacher's own Zoom/Meet/Teams link, shown only on confirmed sessions.
  meetingUrl        String?
  /// Availability windows are in this IANA time zone.
  timeZone          String   @default("UTC")
  sessionMinutes    Int      @default(60)
  acceptingStudents Boolean  @default(true)
  /// Set by an admin to remove the profile from the directory.
  isHidden          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo        ProfilePhoto?
  topics       TeacherTopic[]
  languages    TeacherLanguage[]
  availability AvailabilityWindow[]

  @@index([isHidden, acceptingStudents])
}

/// Kept apart from TeacherProfile so list queries never load image bytes.
model ProfilePhoto {
  profileId   String   @id
  data        Bytes
  contentType String
  updatedAt   DateTime @updatedAt

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  name      String
  slug      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  subject     Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teachers    TeacherTopic[]
  connections TeacherConnection[]

  @@unique([subjectId, slug])
  @@unique([subjectId, name])
}

model TeacherTopic {
  profileId String
  topicId   String

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  topic   Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([profileId, topicId])
  @@index([topicId])
}

model TeacherLanguage {
  profileId String
  language  String

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, language])
  @@index([language])
}

/// A weekly recurring window, in the teacher profile's time zone.
model AvailabilityWindow {
  id          String @id @default(cuid())
  profileId   String
  /// 0 = Sunday ... 6 = Saturday.
  weekday     Int
  /// Minutes after midnight, e.g. 1080 = 18:00.
  startMinute Int
  endMinute   Int

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model TeacherConnection {
  id           String           @id @default(cuid())
  studentId    String
  teacherId    String
  topicId      String?
  status       ConnectionStatus @default(PENDING)
  /// The student's introduction: what they want to learn and why.
  goals        String
  /// The teacher's note when declining.
  responseNote String?
  endedById    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  respondedAt  DateTime?
  endedAt      DateTime?

  student  User              @relation("ConnectionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher  User              @relation("ConnectionTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  topic    Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sessions TutoringSession[]
  messages Message[]

  @@unique([studentId, teacherId])
  @@index([teacherId, status])
}

model TutoringSession {
  id            String         @id @default(cuid())
  connectionId  String
  /// Denormalised from the connection for fast conflict checks.
  teacherId     String
  startsAt      DateTime
  endsAt        DateTime
  status        TutoringStatus @default(CONFIRMED)
  /// What the student wants to cover.
  agenda        String?
  cancelledById String?
  cancelReason  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  connection TeacherConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  teacher    User                @relation("SessionTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  attendance SessionAttendance[]

  @@index([teacherId, startsAt])
  @@index([connectionId, startsAt])
}

/// One stretch of time someone spent in a session's video room, recorded from LiveKit webhooks.
model SessionAttendance {
  id             String    @id @default(cuid())
  sessionId      String
  userId         String
  /// LiveKit's id for this connection. Rejoining gets a new one, so a session can have several rows per person.
  participantSid String    @unique
  joinedAt       DateTime
  leftAt         DateTime?
  createdAt      DateTime  @default(now())

  session TutoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, userId])
  @@index([userId])
}

model Message {
  id           String    @id @default(cuid())
  connectionId String
  senderId     String
  body         String
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  connection TeacherConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender     User              @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
}

model TeacherReview {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  /// 1 to 5.
  rating    Int
  body      String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher User @relation("ReviewTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("ReviewStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@index([teacherId, isHidden])
}

model SavedTeacher {
  studentId String
  teacherId String
  createdAt DateTime @default(now())

  student User @relation("SavedBy", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User @relation("SavedTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([studentId, teacherId])
  @@index([teacherId])
}

/// Fixed-window request counters for rate limiting, shared by every server instance.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
